<Window x:Class="bms_manager.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMS Manager - v0.0.1"
        Height="230"
        Width="360"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">
        <TextBlock Text="{Binding Localization.LanguageLabel}"
                   Margin="0,0,0,6" />

        <ComboBox ItemsSource="{Binding Localization.AvailableLanguages}"
                  SelectedItem="{Binding Localization.CurrentLanguage, Mode=TwoWay}"
                  Margin="0,0,0,12" />

        <TextBlock Text="{Binding Localization.NameLabel}"
                   Margin="0,0,0,6" />

        <TextBox Text="{Binding Name,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"
                 Padding="6"
                 Margin="0,0,0,12" />

        <Button Content="{Binding Localization.SaveButton}"
                Command="{Binding SaveCommand}"
                Padding="8" />

        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
    </StackPanel>

</Window>